  "_attribution": "Material adaptado del System Reference Document 5.1 (SRD 5.1) por Wizards of the Coast LLC, https://dnd.wizards.com/resources/systems-reference-document — bajo Creative Commons Attribution 4.0 (https://creativecommons.org/licenses/by/4.0/legalcode).",
  "_note": "Este archivo usa el mismo formato que homebrew_examples.json. Lo carga el bootstrap del backend si la base no tiene clases. 5 clases representativas del SRD: Bárbaro, Clérigo, Guerrero, Mago, Pícaro. Para las otras 7 (Bardo, Druida, Hechicero, Monje, Paladín, Explorador, Brujo) seguir este mismo patrón.",

  "features": [
    {"tag": "barb:rage",          "name": "Furia",                          "description": "Como acción adicional, entras en furia. Mientras está activa: ventaja en pruebas y TS de FUE; +2 de daño con armas cuerpo a cuerpo (escala con nivel); resistencia a contundente, cortante y perforante. Dura 1 minuto o hasta que no hayas atacado o recibido daño en el último turno. Recuperas usos al descanso largo (corto desde nivel 20).", "origin": "class", "cost": "bonus", "uses": {"max": 2, "formula": "ver tabla", "recharge": "long_rest"}},
    {"tag": "barb:unarmored",     "name": "Defensa Sin Armadura",           "description": "Sin armadura, tu CA = 10 + mod DES + mod CON. Puedes usar escudo y conservar el bono.", "origin": "class", "cost": "passive"},
    {"tag": "barb:reckless",      "name": "Ataque Temerario",               "description": "Al primer ataque del turno con un arma de fuerza puedes hacerlo con ventaja. Hasta tu próximo turno, los ataques contra ti tienen ventaja.", "origin": "class", "cost": "passive"},
    {"tag": "barb:danger-sense",  "name": "Sentido del Peligro",            "description": "Ventaja en TS de DES contra efectos que puedas ver (trampas, hechizos). No funciona si estás cegado, sordo o incapacitado.", "origin": "class", "cost": "passive"},
    {"tag": "barb:extra-attack",  "name": "Ataque Extra",                   "description": "Al usar la acción Atacar puedes hacer dos ataques en lugar de uno.", "origin": "class", "cost": "passive"},
    {"tag": "barb:fast-movement", "name": "Movimiento Rápido",              "description": "Tu velocidad aumenta en 10 pies sin armadura pesada.", "origin": "class", "cost": "passive"},

    {"tag": "cleric:divine-domain", "name": "Dominio Divino",               "description": "Eliges un dominio divino (subclase). Otorga conjuros adicionales y rasgos especiales en niveles 1, 2, 6, 8 y 17.", "origin": "class", "cost": "passive"},
    {"tag": "cleric:channel-divinity", "name": "Canalizar Divinidad",       "description": "Como acción canalizas energía divina. Empiezas con 1 uso (Expulsar Muertos Vivientes) más una opción de dominio. Recuperas en descanso corto o largo.", "origin": "class", "cost": "action", "uses": {"max": 1, "formula": "1/2/3 según nivel", "recharge": "short_rest"}},
    {"tag": "cleric:turn-undead",   "name": "Expulsar Muertos Vivientes",   "description": "Como Canalizar Divinidad: cada muerto viviente a 30 pies que te vea/oiga hace TS SAB o queda expulsado 1 minuto. Niveles altos lo destruyen directamente.", "origin": "class", "cost": "action", "roll_hint": "TS SAB"},
    {"tag": "cleric:divine-strike", "name": "Golpe Divino",                 "description": "Una vez por turno, al golpear con un arma sumas daño extra de tipo apropiado al dominio (1d8 a nivel 8, 2d8 a nivel 14).", "origin": "class", "cost": "passive"},

    {"tag": "fighter:fighting-style", "name": "Estilo de Combate",          "description": "Eliges un estilo: Defensa (+1 CA con armadura), Duelo (+2 daño con arma de una mano), Combate con Dos Armas (sumas mod al segundo ataque), Disparo de Precisión (no penalización por cobertura), Lucha (1d10 vs 1d8 con arma a dos manos), Protección (reacción para imponer desventaja a aliado), Tiro a Distancia (no desventaja en corto, +2 a impactar).", "origin": "class", "cost": "passive"},
    {"tag": "fighter:second-wind", "name": "Segundo Aliento",               "description": "Como acción adicional recuperas 1d10 + nivel HP. 1 uso, recargas en descanso corto o largo.", "origin": "class", "cost": "bonus", "uses": {"max": 1, "formula": "1", "recharge": "short_rest"}, "roll_hint": "1d10+nivel cura"},
    {"tag": "fighter:action-surge", "name": "Acción Adicional",             "description": "En tu turno puedes tomar UNA acción extra además de la normal. 1 uso (2 a nivel 17) por descanso corto o largo.", "origin": "class", "cost": "free", "uses": {"max": 1, "formula": "1 hasta nivel 16, 2 después", "recharge": "short_rest"}},
    {"tag": "fighter:extra-attack", "name": "Ataque Extra",                 "description": "Al atacar puedes hacer 2 ataques. 3 a nivel 11, 4 a nivel 20.", "origin": "class", "cost": "passive"},
    {"tag": "fighter:indomitable",  "name": "Indomable",                    "description": "Repites un TS fallado. 1 uso (2 a nv 13, 3 a nv 17) por descanso largo.", "origin": "class", "cost": "free", "uses": {"max": 1, "formula": "1/2/3", "recharge": "long_rest"}},

    {"tag": "wizard:arcane-recovery", "name": "Recuperación Arcana",        "description": "Una vez por día tras descanso corto, recuperas slots de conjuro. Total de niveles ≤ 1/2 nivel de mago (redondeo arriba), ningún slot de nivel 6+.", "origin": "class", "cost": "free", "uses": {"max": 1, "formula": "1/día", "recharge": "long_rest"}},
    {"tag": "wizard:arcane-tradition", "name": "Tradición Arcana",          "description": "Al nivel 2 eliges una escuela de magia que define tu estudio. Otorga rasgos a niveles 2, 6, 10 y 14.", "origin": "class", "cost": "passive"},
    {"tag": "wizard:spell-mastery",   "name": "Maestría de Conjuros",        "description": "Al nivel 18 eliges 1 conjuro de nivel 1 y 1 de nivel 2 que puedes lanzar a su nivel base sin gastar slot.", "origin": "class", "cost": "passive"},
    {"tag": "wizard:signature-spells", "name": "Conjuros de Firma",         "description": "Al nivel 20 eliges 2 conjuros de nivel 3 que puedes lanzar gratis 1 vez/cada uno por descanso corto.", "origin": "class", "cost": "passive"},

    {"tag": "rogue:expertise",      "name": "Pericia",                      "description": "Eliges 2 habilidades en las que eres competente; el bono de competencia se duplica para esas. A nivel 6 eliges otras 2.", "origin": "class", "cost": "passive"},
    {"tag": "rogue:sneak-attack",   "name": "Ataque Furtivo",               "description": "Una vez por turno, daño extra al golpear con arma sutil/distancia si tienes ventaja, o si un aliado está cerca del objetivo. 1d6 a nivel 1, escala +1d6 cada 2 niveles (10d6 a nivel 19).", "origin": "class", "cost": "passive", "roll_hint": "+Nd6 daño"},
    {"tag": "rogue:cunning-action", "name": "Acción Astuta",                "description": "Como acción adicional puedes Correr, Retirarte o Esconderte.", "origin": "class", "cost": "bonus"},
    {"tag": "rogue:uncanny-dodge",  "name": "Esquiva Sobrenatural",         "description": "Como reacción, al ser golpeado por un atacante que veas, reduces el daño a la mitad.", "origin": "class", "cost": "reaction"},
    {"tag": "rogue:evasion",        "name": "Evasión",                      "description": "En TS DES contra área (ej: bola de fuego): éxito = 0 daño, fallo = mitad de daño.", "origin": "class", "cost": "passive"},

    {"tag": "race:darkvision",      "name": "Visión en la Oscuridad",       "description": "Ves en oscuridad tenue como si fuera luz brillante hasta 60 pies, y en oscuridad como si fuera tenue (sin colores).", "origin": "race", "cost": "passive"},
    {"tag": "race:keen-senses",     "name": "Sentidos Agudos",              "description": "Tienes competencia en la habilidad Percepción.", "origin": "race", "cost": "passive"},
    {"tag": "race:fey-ancestry",    "name": "Ascendencia Feérica",          "description": "Ventaja en TS contra ser hechizado, y la magia no puede dormirte.", "origin": "race", "cost": "passive"},
    {"tag": "race:trance",          "name": "Trance",                       "description": "No duermes. Meditas profundamente 4 horas y obtienes el equivalente a 8 horas de sueño humano.", "origin": "race", "cost": "passive"},
    {"tag": "race:dwarven-resilience", "name": "Resiliencia Enana",         "description": "Ventaja en TS contra veneno y resistencia al daño de veneno.", "origin": "race", "cost": "passive"},
    {"tag": "race:stonecunning",    "name": "Astucia con la Piedra",        "description": "Las pruebas de Historia sobre origen de piedra usan el doble de tu bono de competencia.", "origin": "race", "cost": "passive"},
    {"tag": "race:lucky",           "name": "Afortunado",                   "description": "Cuando sacas un 1 natural en un d20 de ataque, prueba o TS, puedes repetir la tirada y debes usar la nueva.", "origin": "race", "cost": "passive"},
    {"tag": "race:brave",           "name": "Valeroso",                     "description": "Ventaja en TS contra ser asustado.", "origin": "race", "cost": "passive"},
    {"tag": "race:halfling-nimble", "name": "Agilidad de Mediano",          "description": "Puedes moverte por el espacio de cualquier criatura más grande que tú.", "origin": "race", "cost": "passive"}
  ],

