# =====================================================================
# DragonRoll — variables de entorno
# Copia este archivo como `.env` y completa los valores reales.
# NUNCA subas el `.env` real a git: ya está en .gitignore.
# =====================================================================

# --- Base de datos --------------------------------------------------
DB_NAME_MONGO=dragonroll
DB_USER_MONGO=dragonroll
# Genera con: openssl rand -base64 24
DB_PASS_MONGO=cambia-esto-por-favor

# --- JWT (firma de sesiones) ----------------------------------------
# Mínimo 32 caracteres. Genera con: openssl rand -hex 32
JWT_KEY=cambia-esto-por-32-caracteres-min-aleatorios

# --- Sesión Nuxt (cookie HttpOnly firmada) --------------------------
# Genera con: openssl rand -hex 32
SESSION_PASSWORD=cambia-esto-por-32-caracteres-min-aleatorios

# --- Admin inicial (sólo se usa si la DB está vacía) ----------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dragonroll.local
# Cambia esto antes del primer arranque en producción.
ADMIN_PASSWORD=cambia-esta-contraseña-fuerte

# --- Modo Gin -------------------------------------------------------
# `release` para producción, `debug` en desarrollo (más logs).
GIN_MODE=release

# --- URLs y dominios ------------------------------------------------
# CORS: lista coma-separada de orígenes permitidos para el navegador.
# En desarrollo: http://localhost:3000
# En producción con DuckDNS: https://tu-subdominio.duckdns.org
CORS_URLS=https://tu-subdominio.duckdns.org

# Lo que el frontend Nuxt usa como baseUrl público (lo ve el navegador).
PUBLIC_BASE_URL=https://tu-subdominio.duckdns.org
# Lo que el SSR del frontend usa para hablar con el backend (red interna).
PUBLIC_BACKEND_URL=http://backend:8080/api/v1
PUBLIC_AUTH_URL=http://backend:8080/api/v1/auth

# --- HTTPS automático (Caddy) ---------------------------------------
DRAGONROLL_DOMAIN=tu-subdominio.duckdns.org
ACME_EMAIL=tu-email@ejemplo.com

# --- Zona horaria ---------------------------------------------------
TZ=America/Santiago
